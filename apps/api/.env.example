# Puerto del servidor HTTP
PORT=8080

# development | production
# En development se carga el seed de profesionales de prueba.
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Cuánto espera a que terminen los requests en curso antes de apagar
SHUTDOWN_TIMEOUT=10s

# Orígenes que pueden llamar a la API desde un browser, separados por comas.
# Vacío = CORS apagado, que es lo correcto hasta que exista un front desplegado.
# En development, si no se define, se asume http://localhost:3000.
# Sin barra final: el header Origin del browser nunca la trae.
CORS_ORIGENES=http://localhost:3000
